# ============================================================================
# Mic Map — Environment & Single Brand Configuration (.env.example)
# ============================================================================
# No secret values are ever committed. Copy to .env.local for local dev.

# 1. Single Brand Configuration Block (Rename-Safe)
NEXT_PUBLIC_APP_NAME="Mic Map"
NEXT_PUBLIC_APP_DOMAIN="micmap.co"
NEXT_PUBLIC_APP_URL="https://micmap.co"
NEXT_PUBLIC_SUPPORT_EMAIL="support@micmap.co"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="@micmap.co"
NEXT_PUBLIC_SOCIAL_FACEBOOK="micmapco"
NEXT_PUBLIC_DEFAULT_METRO="Greater Cleveland"
NEXT_PUBLIC_DEFAULT_CITY="Cleveland, OH"

# 2. Supabase (Database, Auth, Row Level Security, Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key-server-only"

# 3. Stripe Connect (Server-Side Only — Test Mode for MVP Acceptance)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_server_only"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_server_only"
STRIPE_CONNECT_CLIENT_ID="ca_your_stripe_connect_client_id_server_only"

# 4. GoHighLevel Adapter (Server-Side Only — Master Location: Mic Map HQ)
GHL_API_KEY="your_ghl_private_integration_token_server_only"
GHL_LOCATION_ID="your_ghl_mic_map_hq_location_id_server_only"

# 5. Geocoding / Maps Provider (Server-Side Seed & Map Tiles)
MAPS_GEOCODING_API_KEY="your_geocoding_api_key_optional_osm_nominatim_fallback"
